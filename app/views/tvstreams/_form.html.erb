<%= form_with(model: tvstream) do |form| %>
  <% if tvstream.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(tvstream.errors.count, "error") %> prohibited this tvstream from being saved:</h2>

      <ul>
        <% tvstream.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :firsttv, style: "display: block" %>
    <%= form.text_field :firsttv %>
  </div>

  <div>
    <%= form.label :mytv, style: "display: block" %>
    <%= form.text_field :mytv %>
  </div>

  <div>
    <%= form.label :tv_id, style: "display: block" %>
    <%= form.number_field :tv_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
